# Fish Audio / Fish Studio API key. Never commit your real key.
FISH_API_KEY=your_fish_audio_api_key_here

# Optional compatibility aliases accepted by autocut:
# FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# FISH_STUDIO_API_KEY=your_fish_audio_api_key_here

# Optional default voice model id from fish.audio voice URL.
# FISH_REFERENCE_ID=802e3bc2b27e49c2995d23ef70e6ac89
